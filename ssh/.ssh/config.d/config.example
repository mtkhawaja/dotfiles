# Sample private include — copy to a real <name>.conf in this directory and edit.
# SSH loads ~/.ssh/config.d/*.conf; this *.example file is NOT loaded by SSH.
# See README.md in this directory for the full guide (adding accounts, cloning).

Host github.com-work
    HostName github.com
    User git
    IdentitiesOnly yes
    IdentityFile ~/.ssh/work_github.pub
