# Managed by dotfiles (~/.dotfiles/ssh) — public, personal entries only.
# Work GitHub accounts and private servers live in ~/.ssh/config.d/*.conf,
# which is NOT tracked here. SSH uses the first value it finds for each option,
# so the Include is first and lets private entries override anything below.
Include ~/.ssh/config.d/*.conf

# Personal GitHub account. Keys are served by the Bitwarden desktop agent;
# IdentitiesOnly + the public key pin this host to the personal identity so the
# agent doesn't offer a work key by mistake. No private key touches disk.
#
# To refresh/fact-check mtkhawaja_github.pub, list the keys GitHub has registered
# for this account: https://github.com/mtkhawaja.keys — the pinned blob must
# appear there, or auth fails with "Permission denied (publickey)".
Host github.com
    HostName github.com
    User git
    IdentitiesOnly yes
    IdentityFile ~/.ssh/mtkhawaja_github.pub

# Route auth through the Bitwarden desktop SSH agent on macOS. On Linux/WSL this
# Match is skipped and SSH falls back to $SSH_AUTH_SOCK (exported in .zshenv).
Match exec "uname -s | grep -iq darwin"
    IdentityAgent ~/Library/Containers/com.bitwarden.desktop/Data/.bitwarden-ssh-agent.sock
