#!/usr/bin/env zsh
# setup.sh copies this to .secrets in the repo root (mode 0600) if it does not
# exist yet, and .zshenv sources it from there. Edit .secrets with your real
# values; never commit it.
# This is sourced shell code: keep it quiet and use quoted assignments.
# Exports here reach every normal zsh invocation and its child processes.
# Uncomment only what you use; replace placeholders with real credentials.

# GitHub CLI (gh): overrides credentials saved by `gh auth login`.
# https://cli.github.com/manual/gh_help_environment
# export GITHUB_TOKEN='replace-me'

# npm: requires //registry.npmjs.org/:_authToken=${NPM_TOKEN} in .npmrc.
# https://docs.npmjs.com/using-private-packages-in-a-ci-cd-workflow/
# export NPM_TOKEN='replace-me'

# Hugging Face Hub: overrides the locally saved token.
# https://huggingface.co/docs/huggingface_hub/package_reference/environment_variables
# export HF_TOKEN='replace-me'

# Artifactory / Maven: these names are conventions, not auto-detected by Maven.
# Reference ${env.ARTIFACTORY_USERNAME} and ${env.ARTIFACTORY_PASSWORD}
# in the appropriate <server> entry in ~/.m2/settings.xml.
# https://maven.apache.org/settings.html
# export ARTIFACTORY_USERNAME='replace-me'
# export ARTIFACTORY_PASSWORD='replace-me'

# uv / PyPI publishing: `uv publish` reads this token automatically.
# Installing public packages from PyPI requires no credentials.
# https://docs.astral.sh/uv/guides/package/#publishing-your-package
# https://pypi.org/help/#apitoken
# export UV_PUBLISH_TOKEN='replace-me'

# uv / private package installs: configure a named index in pyproject.toml:
#   [[tool.uv.index]]
#   name = "internal"
#   url = "https://packages.example.com/simple/"
# Match INTERNAL to the index name (uppercase; punctuation becomes underscores).
# These credentials are for installing/resolving, not `uv publish`.
# https://docs.astral.sh/uv/concepts/indexes/#authentication
# export UV_INDEX_INTERNAL_USERNAME='replace-me'
# export UV_INDEX_INTERNAL_PASSWORD='replace-me'
