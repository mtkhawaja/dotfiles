# Global git ignores (referenced by core.excludesfile in ~/.gitconfig).
# Machine/OS/editor junk that should never be committed in ANY repo.

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Editors / IDEs
.idea/
.vscode/
*.swp
*.swo
*~

# Python
*.pyc
__pycache__/

# Environment / secrets
.env
.env.*
!.env.example
!.env.sample
!.env.template
*.secret
*.secrets
.vault-token

# AWS: access keys and cached SSO/CLI session tokens. .credentials.* covers
# aws-creds-to-default.py's temp file should a write ever be interrupted.
**/.aws/credentials
**/.aws/sso/cache/
**/.aws/cli/cache/
.credentials.*
.boto
.s3cfg

# Credential stores that hold plaintext passwords or tokens
.git-credentials
.netrc
_netrc
.pgpass
.my.cnf

# SSH private keys (the .pub halves stay committable)
id_rsa
id_ecdsa
id_ecdsa_sk
id_ed25519
id_ed25519_sk

# Keys / certificates / keystores
*.pem
*.key
*.jks
*.keystore
*.p12
*.pfx

# Claude Code (machine-local / secret — never commit)
settings.local.json
.claude.json
.credentials.json
CLAUDE.local.md

# Logs
*.log
logs/
log/
