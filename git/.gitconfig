[user]
    email = 36654508+mtkhawaja@users.noreply.github.com
    name = Muneeb Khawaja
	signingkey = 535C84F6751CC5C4

# Work identity override: applied automatically to any repo whose remote uses the
# github.com-work SSH alias (see ssh/.ssh/config.d). The real work identity lives in
# the git-ignored ~/.gitconfig.d/work.config — see ~/.gitconfig.d/README.md.
[includeIf "hasconfig:remote.*.url:git@github.com-work:*/**"]
    path = ~/.gitconfig.d/work.config

[core]
	editor = nvim
    excludesfile = ~/.gitignore_global
    # https://stackoverflow.com/questions/3206843/how-line-ending-conversions-work-with-git-core-autocrlf-between-different-operat
	autocrlf = input

[color]
    ui = auto

[color "branch"]
    current = green bold
    local = yellow
    remote = blue

[commit]
    verbose = true

[diff]
    tool = nvimdiff
    colorMoved = default
    # histogram produces cleaner, more readable diffs than the default Myers.
    algorithm = histogram

[rerere]
    # Remember how conflicts were resolved and replay them automatically.
    enabled = true

[branch]
    # List most-recently-committed branches first in `git branch`.
    sort = -committerdate

[column]
    ui = auto

[help]
    # Prompt before running an autocorrected command instead of guessing.
    autocorrect = prompt

[difftool]
    prompt = false

[merge]
    tool = nvimdiff
    conflictStyle = diff3

[mergetool]
    prompt = false

[init]
    defaultBranch = main

[pull]
    ff = only

[rebase]
    autosquash = true
    autostash = true

[fetch]
    prune = true
    pruneTags = true

[push]
    default = simple
    followTags = true
    # Auto-create the upstream on first push of a new branch (no --set-upstream). Git >= 2.37.
    autoSetupRemote = true

[status]
    short = true
    branch = true

[alias]
    st = status -sb
    co = checkout
    br = branch
    ci = commit
    df = diff
    lg = log --graph --decorate --oneline --all
    last = log -1 HEAD
    fp = fetch --prune
    rv = remote -v
