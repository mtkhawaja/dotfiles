# Default identity everywhere: personal. Machine and per-account overrides are
# included at the end of this file.
[include]
    path = ~/.gitconfig.d/personal.config

[core]
	editor = nvim
    excludesfile = ~/.gitignore_global
    # https://stackoverflow.com/questions/3206843/how-line-ending-conversions-work-with-git-core-autocrlf-between-different-operat
	autocrlf = input

[color]
    ui = auto

[color "branch"]
    current = green bold
    local = yellow
    remote = blue

[commit]
    verbose = true

[diff]
    tool = nvimdiff
    colorMoved = default
    # histogram produces cleaner, more readable diffs than the default Myers.
    algorithm = histogram

[rerere]
    # Remember how conflicts were resolved and replay them automatically.
    enabled = true

[branch]
    # List most-recently-committed branches first in `git branch`.
    sort = -committerdate

[column]
    ui = auto

[help]
    # Prompt before running an autocorrected command instead of guessing.
    autocorrect = prompt

[difftool]
    prompt = false

[merge]
    tool = nvimdiff
    conflictStyle = diff3

[mergetool]
    prompt = false

[init]
    defaultBranch = main

[pull]
    ff = only

[rebase]
    autosquash = true
    autostash = true

[fetch]
    prune = true
    pruneTags = true

[push]
    default = simple
    followTags = true
    # Auto-create the upstream on first push of a new branch (no --set-upstream). Git >= 2.37.
    autoSetupRemote = true

[status]
    short = true
    branch = true

[alias]
    st = status -sb
    co = checkout
    br = branch
    ci = commit
    df = diff
    lg = log --graph --decorate --oneline --all
    last = log -1 HEAD
    fp = fetch --prune
    rv = remote -v
    # Manage extra identities (GitHub orgs, Bitbucket, GitLab): git account --help
    account = !git-account.py

# Identity and machine-specific overrides — keep these last so they win. Later
# includes override earlier ones, so the order below matters. Missing files are
# skipped silently. See ~/.gitconfig.d/README.md.
#
# 1. Machine overrides (git-ignored; optional). setup.sh moves a pre-existing
#    ~/.gitconfig here. Put anything this machine needs differently in it, e.g. a
#    different default identity:  [user] email = me@corp.com
[include]
    path = ~/.gitconfig.d/local.config

# 2. github.com remotes are personal even if local.config changed the default.
[includeIf "hasconfig:remote.*.url:git@github.com:*/**"]
    path = ~/.gitconfig.d/personal.config
[includeIf "hasconfig:remote.*.url:https://github.com/**"]
    path = ~/.gitconfig.d/personal.config

# 3. Other accounts (GitHub orgs, Bitbucket, ...), each selected by its folder
#    (~/source-code/<name>/), SSH alias, or URL patterns. Git-ignored; managed by
#    `git account` (see ~/.gitconfig.d/README.md).
[include]
    path = ~/.gitconfig.d/accounts.config
